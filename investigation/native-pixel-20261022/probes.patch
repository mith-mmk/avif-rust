+fn investigation_stage_dump(frame: &DecodedFrame, stage: &str) {
+    if frame.color_config.monochrome {
+        return;
+    }
+    use std::io::Write;
+    let Ok(dir) = std::env::var("AVIF_STAGE_DIR") else {
+        return;
+    };
+    let mut out = std::fs::File::create(format!("{dir}/{stage}.yuv")).unwrap();
+    for p in &frame.buffers.planes {
+        let w = frame
+            .width
+            .div_ceil(1 << usize::from(p.layout.subsampling_x));
+        let h = frame
+            .height
+            .div_ceil(1 << usize::from(p.layout.subsampling_y));
+        for y in 0..h {
+            for x in 0..w {
+                let v = p.samples[y * p.layout.stride() + x];
+                if frame.bit_depth > 8 {
+                    out.write_all(&v.to_le_bytes()).unwrap();
+                } else {
+                    out.write_all(&[v as u8]).unwrap();
+                }
+            }
+        }
+    }
