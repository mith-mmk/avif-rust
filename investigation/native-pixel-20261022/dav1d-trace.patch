+static void trace_uv_edge(const Dav1dFrameContext *f, pixel *dst, const ptrdiff_t ls, const uint32_t *mask, const uint8_t (*lvl)[4], ptrdiff_t b4_stride, int n, int vertical, const char *phase) {
+    if (!getenv("AVIF_EDGE_TRACE")) return;
+    ptrdiff_t pos=dst-(pixel*)f->cur.data[1];
+    int x=pos%PXSTRIDE(ls),y=pos/PXSTRIDE(ls);
+    for(int j=0;j<n;j++) {
+        if(!((mask[0]|mask[1])&(1U<<j))) continue;
+        int ex=x+(vertical?0:4*j),ey=y+(vertical?4*j:0);
+        if(ex<596 || ex>604 || ey>8) continue;
+        const uint8_t (*l)[4]=lvl+(vertical?j*b4_stride:j);
+        int L=l[0][0]?l[0][0]:l[vertical?-1:-b4_stride][0];
+        fprintf(stderr,"DAV %s x=%d y=%d v=%d len=%d L=%d E=%d I=%d H=%d\n",phase,ex,ey,vertical,4+2*!!(mask[1]&(1U<<j)),L,f->lf.lim_lut.e[L],f->lf.lim_lut.i[L],L>>4);
+        pixel *q=dst+(vertical?4*j*PXSTRIDE(ls):4*j);
+        for(int lane=0;lane<4;lane++) {fprintf(stderr,"DAV taps %d",lane);for(int d=-3;d<3;d++) fprintf(stderr," %d",q[(vertical?lane*PXSTRIDE(ls):lane)+(vertical?d:d*PXSTRIDE(ls))]);fprintf(stderr,"\n");}
+    }
+}
